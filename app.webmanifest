{
  "name": "Niall's Toolkit",
  "short_name": "Toolkit",
  "description": "Amazon storefront tracker, FBA returns tracker, FBA accounting, supplier outreach and eBay profit tracker.",
  "id": "./dashboard.html",
  "start_url": "./dashboard.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef0f4",
  "theme_color": "#2a0f47",
  "share_target": {
    "action": "./dashboard.html",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Log a spend", "url": "./dashboard.html#fbaadmin/cashflow/log", "icons": [{ "src": "icons/icon192.png", "sizes": "192x192" }] },
    { "name": "Snap a receipt", "url": "./dashboard.html#fbaadmin/invoices/camera", "icons": [{ "src": "icons/icon192.png", "sizes": "192x192" }] },
    { "name": "Outreach", "url": "./dashboard.html#outreach/overview", "icons": [{ "src": "icons/icon192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icons/icon192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
