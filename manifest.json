{
  "manifest_version": 3,
  "name": "Niall's Toolkit",
  "short_name": "Niall's Toolkit",
  "version": "2.2.0",
  "minimum_chrome_version": "116",
  "description": "Amazon storefront tracker, supplier outreach, FBA returns tracker, FBA accounting and eBay profit tracker. Syncs with the app on your phone through your Google Drive.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Niall's Toolkit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "dashboard.html?panel=1"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "sidePanel",
    "identity",
    "alarms"
  ],
  "host_permissions": [
    "https://api.keepa.com/*",
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.co.uk/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
